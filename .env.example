# Port the production server listens on (npm start). Defaults to 3000.
PORT=3000

# Optional: absolute path to the SQLite database file.
# Defaults to <repo-root>/data/diy-shed.db when unset.
# DIYSHED_DB=/absolute/path/to/diy-shed.db

# Research (M2): how long a single Claude CLI research run may take before it is
# killed. Milliseconds; defaults to 300000 (5 min).
# DIYSHED_RESEARCH_TIMEOUT_MS=300000

# Research (M2): max concurrent research jobs in the in-process queue.
# Defaults to 1, capped at 2.
# DIYSHED_RESEARCH_CONCURRENCY=1
